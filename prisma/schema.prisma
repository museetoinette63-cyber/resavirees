generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev working (Windows); "rhel-openssl-3.0.x" is the
  // query engine binary Vercel's serverless Node.js runtime needs — without
  // it, the generated client only ships the Windows binary and every DB
  // call throws a runtime error in production (masked as a generic 500 with
  // an opaque digest by Next.js's production error handling).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum NiveauForfait {
  NIVEAU_1
  NIVEAU_2
}

enum CreneauStatus {
  PUBLIE // visible et réservable sur le site public
  RESERVE // lié à une réservation active, masqué du site public
  MASQUE // masqué manuellement par l'admin (incl. après annulation, en attente de republication)
}

enum ReservationStatus {
  DEMANDE_RECUE // 1
  DEVIS_INTERNE_GENERE // 2
  EN_ATTENTE_VALIDATION_ADMIN // 3
  DEVIS_VALIDE // 4
  DEVIS_ENVOYE // 5
  ACOMPTE_EN_ATTENTE // 6
  ACOMPTE_RECU // 7a
  ACOMPTE_EXPIRE // 7b
  CONFIRME // 8
  REALISE // 9
  FACTURE_AJUSTEE // 10
  FACTURE_ENVOYEE // 11
  SOLDE // 12
  ANNULE // branche annulation, déclenchable de 1 à 9
}

enum StatutPaiement {
  EN_ATTENTE
  RECU
  EXPIRE
}

enum AdminRole {
  ADMIN // MVP : seul rôle utilisé ; prêt pour des profils différenciés plus tard
}

// ---------- Core models ----------

model Visite {
  id               String  @id @default(cuid())
  nom              String
  slug             String  @unique
  description      String  @db.Text
  imageBanniereUrl String?
  visible          Boolean @default(false)

  tarifAdulte Decimal @db.Decimal(10, 2)
  tarifEnfant Decimal @db.Decimal(10, 2)

  majorationTardiveMontant     Decimal @default(0) @db.Decimal(10, 2)
  majorationTardiveDelaiHeures Int     @default(48)

  acomptePourcentage Decimal @default(30) @db.Decimal(5, 2)
  acompteDelaiJours  Int     @default(30)

  reglesForfait RegleForfait[]
  creneaux      Creneau[]
  produits      Produit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Catalogue de produits/prestations facturables, sélectionnables comme
 * lignes sur un devis ou une facture (DevisLigne/FactureLigne). Distinct des
 * `Visite` (qui pilotent le site public + les créneaux) : un produit peut
 * représenter une visite (lien optionnel `visiteId`, pratique pour
 * pré-remplir la ligne générée automatiquement à la réservation) ou tout
 * autre article facturable (supplément, prestation annexe...) sans lien.
 */
model Produit {
  id           String  @id @default(cuid())
  nom          String // dénomination
  description  String? @db.Text
  prixUnitaire Decimal @db.Decimal(10, 2)
  dureeMinutes Int? // durée typique de la prestation, en minutes
  actif        Boolean @default(true)

  visiteId String?
  visite   Visite? @relation(fields: [visiteId], references: [id])

  devisLignes   DevisLigne[]
  factureLignes FactureLigne[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegleForfait {
  id       String        @id @default(cuid())
  visiteId String
  visite   Visite        @relation(fields: [visiteId], references: [id], onDelete: Cascade)
  niveau   NiveauForfait

  // NIVEAU_1 uniquement :
  seuilAdultes Int?
  seuilEnfants Int?
  // NIVEAU_2 uniquement :
  seuilGlobal Int?

  montant Decimal @db.Decimal(10, 2)
  actif   Boolean @default(true)

  @@unique([visiteId, niveau])
}

model Creneau {
  id        String        @id @default(cuid())
  visiteId  String
  visite    Visite        @relation(fields: [visiteId], references: [id])
  dateHeure DateTime // instant UTC de la visite
  status    CreneauStatus @default(PUBLIE)

  reservation Reservation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visiteId, dateHeure])
  @@index([status])
}

model Reservation {
  id        String  @id @default(cuid())
  creneauId String  @unique
  creneau   Creneau @relation(fields: [creneauId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  // coordonnées capturées au moment de la réservation (indépendantes d'un compte client)
  nomOuRaisonSociale String
  telephone          String
  email              String
  adressePostale     String
  nbAdultes          Int
  nbEnfants          Int

  status          ReservationStatus @default(DEMANDE_RECUE)
  notesAdmin      String?           @db.Text
  dateReservation DateTime          @default(now()) // ancre pour le calcul de majoration tardive

  googleEventId String? // sync unidirectionnelle back-office -> Google Agenda

  historique ReservationStatusHistory[]
  devis      Devis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ReservationStatusHistory {
  id            String             @id @default(cuid())
  reservationId String
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  changedAt     DateTime           @default(now())
  changedBy     String? // AdminUser.email, null = système/automatique
  note          String?            @db.Text

  @@index([reservationId])
}

model Devis {
  id     String @id @default(cuid())
  numero String @unique // DEV-2026-00001

  // Relation normale 1-1 avec une Reservation générée par le workflow, mais §3.4 exige
  // aussi l'ajout MANUEL d'un devis à un compte client hors parcours de réservation.
  reservationId   String?      @unique
  reservation     Reservation? @relation(fields: [reservationId], references: [id])
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  origineManuelle Boolean      @default(false)

  nbAdultes           Int
  nbEnfants           Int
  tarifAdulteApplique Decimal @db.Decimal(10, 2)
  tarifEnfantApplique Decimal @db.Decimal(10, 2)

  forfaitApplique            NiveauForfait?
  montantForfait              Decimal?       @db.Decimal(10, 2)
  coutIndividuelTotal         Decimal        @db.Decimal(10, 2)
  montantAvantMajoration      Decimal        @db.Decimal(10, 2)
  majorationTardiveAppliquee  Boolean        @default(false)
  montantMajoration           Decimal        @default(0) @db.Decimal(10, 2)
  montantTotal                Decimal        @db.Decimal(10, 2)
  tauxTVA                     Decimal        @default(0) @db.Decimal(5, 2)

  acomptePourcentage         Decimal        @db.Decimal(5, 2)
  acompteMontant              Decimal        @db.Decimal(10, 2)
  acompteDelaiJours           Int
  acompteDateLimite           DateTime?
  acompteStatutPaiement       StatutPaiement @default(EN_ATTENTE)
  acompteDateReglement        DateTime?
  acompteReferenceReglement   String?

  validePar String?
  valideLe  DateTime?
  envoyeLe  DateTime?
  pdfUrl    String?

  // Date/heure/durée de la prestation affichées sur le devis/la facture.
  // Pour un devis rattaché à une réservation, renseignées automatiquement
  // depuis le créneau à la création ; pour un devis manuel, saisies par
  // l'admin (§3.4 — pas de créneau à rattacher).
  dateEvenement DateTime?
  dureeMinutes  Int?
  notes         String?   @db.Text

  lignes  DevisLigne[]
  facture Facture?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Ligne de devis (produit + quantité + prix unitaire). `denomination` et
 * `prixUnitaire` sont dupliqués depuis `Produit` au moment de l'ajout
 * (snapshot) : si l'admin modifie le catalogue plus tard, les devis déjà
 * émis ne doivent pas changer rétroactivement.
 */
model DevisLigne {
  id      String @id @default(cuid())
  devisId String
  devis   Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)

  produitId String?
  produit   Produit? @relation(fields: [produitId], references: [id])

  denomination String
  quantite     Int     @default(1)
  prixUnitaire Decimal @db.Decimal(10, 2)
  montantLigne Decimal @db.Decimal(10, 2) // quantite * prixUnitaire
  ordre        Int     @default(0)

  @@index([devisId])
}

model Facture {
  id       String  @id @default(cuid())
  numero   String  @unique // FAC-2026-00001
  devisId  String  @unique
  devis    Devis   @relation(fields: [devisId], references: [id])
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  nbAdultesReel Int
  nbEnfantsReel Int
  montantFinal  Decimal @db.Decimal(10, 2)
  tauxTVA       Decimal @default(0) @db.Decimal(5, 2)

  ajuste    Boolean   @default(false)
  ajusteLe  DateTime?
  ajustePar String?

  soldeStatutPaiement     StatutPaiement @default(EN_ATTENTE)
  soldeDateReglement      DateTime?
  soldeReferenceReglement String?

  noteLitige String?   @db.Text
  envoyeeLe  DateTime?
  pdfUrl     String?
  notes      String?   @db.Text

  lignes FactureLigne[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Ligne de facture — même principe de snapshot que DevisLigne. */
model FactureLigne {
  id        String  @id @default(cuid())
  factureId String
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  produitId String?
  produit   Produit? @relation(fields: [produitId], references: [id])

  denomination String
  quantite     Int     @default(1)
  prixUnitaire Decimal @db.Decimal(10, 2)
  montantLigne Decimal @db.Decimal(10, 2)
  ordre        Int     @default(0)

  @@index([factureId])
}

model Client {
  id                 String  @id @default(cuid())
  nomOuRaisonSociale String
  email              String  @unique
  telephone          String?
  adressePostale     String?
  notes              String? @db.Text

  reservations Reservation[]
  devis        Devis[]
  factures     Facture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nom          String?
  role         AdminRole @default(ADMIN)
  actif        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id                 Int      @id @default(1) // ligne singleton
  siteName           String?
  headerImageUrl     String?
  backgroundImageUrl String?

  // Informations "expéditeur" affichées sur les devis/factures (identité de
  // l'association émettrice) et conditions générales de vente — cahier des
  // charges : facture entièrement remplie avec raison sociale, SIRET,
  // contact du vendeur et CGV.
  raisonSociale    String?
  siret            String?
  adresseSiege     String? @db.Text
  emailContact     String?
  telephoneContact String?
  cgvTexte         String? @db.Text

  // Ambiance sonore optionnelle (fichier audio uploadé par l'admin — horloge
  // comtoise, feu de cheminée, oiseaux...). Lecture déclenchée par un clic
  // visiteur (les navigateurs bloquent l'autoplay sonore de toute façon),
  // coupée par défaut.
  sonAmbianceUrl String?
  sonAmbianceNom String?

  updatedAt DateTime @updatedAt
}

model NumberingCounter {
  id  String @id // ex. "DEVIS-2026", "FACTURE-2026"
  seq Int    @default(0)
}

enum BlocEmplacement {
  ACCUEIL // page catalogue uniquement
  SITE_ENTIER // toutes les pages publiques (rendu dans le layout public)
}

enum BlocType {
  TEXTE // titre + paragraphe(s)
  TEXTE_IMAGE // idem + image
  ENCART // mise en avant visuelle (fond/bordure marqués) — annonce, alerte
}

/**
 * Blocs de contenu personnalisables par l'admin, affichés sur le site
 * public sans intervention développeur (personnalisation demandée par le
 * client : "encarts", infos, annonces...).
 */
model BlocContenu {
  id          String          @id @default(cuid())
  type        BlocType
  emplacement BlocEmplacement
  titre       String?
  contenu     String          @db.Text
  imageUrl    String?
  ordre       Int             @default(0)
  actif       Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emplacement, actif, ordre])
}

/** Photos du diaporama d'en-tête (défilement automatique, site entier). */
model PhotoCarrousel {
  id      String  @id @default(cuid())
  url     String
  legende String?
  ordre   Int     @default(0)
  actif   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif, ordre])
}
