<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document mc:Ignorable="w14 w15 wp14" xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex"><w:body><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="44"/><w:szCs w:val="44"/></w:rPr><w:t xml:space="preserve">Cahier des charges</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="400"/></w:pPr><w:r><w:rPr><w:color w:val="555555"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">Plateforme de réservation de visites guidées théâtralisées</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="200" w:before="400"/></w:pPr><w:r><w:t xml:space="preserve">1. Contexte et objectif</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Développement sur mesure d&apos;une plateforme de réservation en ligne pour des visites guidées théâtralisées, comprenant un site public de réservation et un back-office métier permettant la gestion complète des visites, créneaux, tarifs, devis, factures et comptes clients.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">La structure porteuse est une association, non assujettie à la TVA (0% sur l&apos;ensemble des documents commerciaux).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="200" w:before="400"/></w:pPr><w:r><w:t xml:space="preserve">2. Front-end (site public)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">2.1 Catalogue de visites</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Chaque visite est un « produit » composé de :</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">image bannière</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">description</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">un ou plusieurs tarifs associés (adulte / enfant)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">règles de forfait et de majoration propres à la visite (voir §4)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Chaque visite peut être affichée ou masquée du site public indépendamment. En-têtes et images de fond du site personnalisables depuis le back-office.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">2.2 Formulaire de réservation</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Champs requis :</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Nom / prénom ou raison sociale</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Téléphone</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">E-mail</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Adresse postale</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Nombre de personnes (détail adultes / enfants)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">2.3 Créneaux</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Chaque créneau correspond à une seule visite, à une date et une heure données.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Un créneau = une réservation. Dès qu&apos;une réservation est effectuée, le créneau disparaît du site public.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Après une annulation, le créneau ne redevient disponible qu&apos;après republication manuelle par l&apos;administrateur.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="200" w:before="400"/></w:pPr><w:r><w:t xml:space="preserve">3. Back-office (accès protégé par mot de passe)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">3.1 Gestion des visites</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Création, modification, suppression de visites de A à Z (contenu, tarifs, règles de forfait/majoration, visibilité).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">3.2 Onglet « Créneaux »</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Création de créneaux en lot, plusieurs années à l&apos;avance (ex. 8, 30, 60 dates en une fois), en choisissant :</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">jours de la semaine</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">mois / années</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">horaires</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">visite(s) associée(s)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Suppression ou masquage de créneaux, y compris en lot.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">3.3 Onglet « Calendrier »</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Vue jour par jour et vue d&apos;ensemble de toutes les réservations en cours.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Modification de chaque réservation, ajout de notes.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Synchronisation avec Google Agenda en mode unidirectionnel (back-office → Google Agenda). Le back-office reste la source de vérité.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">3.4 Onglet « Comptes clients »</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Création de comptes clients.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Historique des devis et factures rattachés à chaque compte.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Ajout manuel d&apos;un devis ou d&apos;une facture à un compte client existant.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">3.5 Paramètres</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Tous les paramètres de tarification (forfaits, seuils, majoration, acompte) sont configurables individuellement, par visite — aucune valeur codée en dur.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="200" w:before="400"/></w:pPr><w:r><w:t xml:space="preserve">4. Logique de tarification</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">La tarification est le point le plus complexe du système ; elle doit être entièrement paramétrable par visite et centralisée dans un moteur de règles unique.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.1 Paramètres par visite</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Tarif individuel adulte, tarif individuel enfant.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Forfait 1 : seuil adultes, seuil enfants, montant forfaitaire, actif/inactif.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Forfait 2 (optionnel, activable) : seuil global (ex. total &gt; 50 personnes), montant forfaitaire.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Majoration réservation tardive : montant fixe, applicable si réservation faite moins de 48h avant l&apos;événement.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80"/></w:pPr><w:r><w:t xml:space="preserve">Acompte : pourcentage (30% par défaut) et délai de règlement (1 mois par défaut), paramétrables par visite.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.2 Règle d&apos;éligibilité au forfait 1</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Le groupe est éligible au forfait 1 si : nb_adultes &lt; seuil_adultes_1 OU nb_enfants &lt; seuil_enfants_1.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Le groupe n&apos;est pas éligible si les deux seuils sont dépassés simultanément.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.3 Règle d&apos;application du montant (forfait 1)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Si le groupe est éligible, le forfait s&apos;applique par défaut, mais le coût individuel total est calculé en parallèle. Si ce coût dépasse le montant du forfait, c&apos;est le tarif individuel qui est facturé.</w:t></w:r></w:p><w:p><w:pPr><w:shd w:fill="F2F2F2" w:val="clear"/><w:spacing w:after="200" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">SI groupe éligible au forfait 1 :</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:br/><w:t xml:space="preserve">    montant = MAX(forfait_1, coût_individuel_total)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.4 Forfait 2 (seuil additionnel optionnel)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Si activé et si le total de personnes dépasse le seuil défini, le forfait 2 s&apos;applique selon exactement la même logique que le forfait 1 (substitution, jamais cumul) :</w:t></w:r></w:p><w:p><w:pPr><w:shd w:fill="F2F2F2" w:val="clear"/><w:spacing w:after="200" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">SINON SI forfait_2 actif ET total_personnes &gt; seuil_2 :</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:br/><w:t xml:space="preserve">    montant = MAX(forfait_2, coût_individuel_total)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.5 Cas général</w:t></w:r></w:p><w:p><w:pPr><w:shd w:fill="F2F2F2" w:val="clear"/><w:spacing w:after="200" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">SINON :</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:br/><w:t xml:space="preserve">    montant = coût_individuel_total</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.6 Cumul de forfaits</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Aucun cumul de forfaits n&apos;est autorisé, à l&apos;exception du mécanisme décrit en 4.4 (le forfait 2 se substitue au forfait 1, il ne s&apos;y ajoute jamais).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.7 Majoration tardive</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Appliquée sur le montant final obtenu après application des règles 4.3 à 4.5 :</w:t></w:r></w:p><w:p><w:pPr><w:shd w:fill="F2F2F2" w:val="clear"/><w:spacing w:after="200" w:before="100"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">SI réservation faite &lt; 48h avant l&apos;événement :</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:cs="Consolas" w:eastAsia="Consolas" w:hAnsi="Consolas"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:br/><w:t xml:space="preserve">    montant += majoration (montant fixe, paramétrable par visite)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">4.8 Modification du nombre de personnes après validation</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="150"/></w:pPr><w:r><w:t xml:space="preserve">Si le client demande à ajouter des personnes après validation du devis, la gestion se fait manuellement par l&apos;administrateur (pas de recalcul automatique).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="200" w:before="400"/></w:pPr><w:r><w:t xml:space="preserve">5. Cycle de réservation — devis et facturation</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:after="150" w:before="300"/></w:pPr><w:r><w:t xml:space="preserve">5.1 Machine à états</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:type="dxa" w:w="8900"/><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4"/><w:left w:val="single" w:color="auto" w:sz="4"/><w:bottom w:val="single" w:color="auto" w:sz="4"/><w:right w:val="single" w:color="auto" w:sz="4"/><w:insideH w:val="single" w:color="auto" w:sz="4"/><w:insideV w:val="single" w:color="auto" w:sz="4"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="500"/><w:gridCol w:w="2200"/><w:gridCol w:w="2600"/><w:gridCol w:w="3600"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="500"/><w:shd w:fill="DDE6F0" w:val="clear"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">#</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2200"/><w:shd w:fill="DDE6F0" w:val="clear"/></w:tcPr><w:p><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">Statut</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2600"/><w:shd w:fill="DDE6F0" w:val