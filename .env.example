# Base de données PostgreSQL (ex. Supabase)
# DATABASE_URL : connexion utilisée par l'app (pooler de transactions si Supabase)
# DIRECT_URL   : connexion directe / session pooler, utilisée par les migrations Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/visites_theatralisees"
DIRECT_URL="postgresql://user:password@localhost:5432/visites_theatralisees"

# NextAuth (back-office)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-a-long-random-string"

# E-mail (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="change-me"
SMTP_FROM="Association Visites <no-reply@example.com>"

# Google Agenda (sync unidirectionnelle back-office -> Google Agenda)
# Laisser à false tant que les identifiants OAuth du client ne sont pas configurés.
GOOGLE_CALENDAR_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
